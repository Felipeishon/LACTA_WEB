rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES DE CONTROL DE ACCESO ---
    function datosUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol.hasAny(['admin']);
    }

    function isPrestador() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             datosUsuario().rol.hasAny(['consejera', 'cuidadora', 'admin']);
    }

    function esMiembroDelNido(nidoId) {
      return nidoId != null &&
             exists(/databases/$(database)/documents/nidos/$(nidoId)) &&
             request.auth.uid in get(/databases/$(database)/documents/nidos/$(nidoId)).data.padresUids;
    }

    // --- SEGURIDAD POR COLECCIÓN ---
    match /usuarios/{userId} {
      allow read, update: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth != null
        && (
          (
            request.auth.uid == userId &&
            request.resource.data.email == request.auth.token.email &&
            (request.resource.data.rol is list) &&
            request.resource.data.rol.size() > 0 &&
            request.resource.data.rol.hasOnly(['padre', 'consejera', 'cuidadora', 'admin'])
          ) || isAdmin()
        );
      allow delete: if isAdmin();
      
      match /caregiverProfile/{docId} {
        allow get, list, write: if request.auth.uid == userId || isAdmin();
      }
      match /counselorProfile/{docId} {
        allow get, list, write: if request.auth.uid == userId || isAdmin();
      }
      match /bloqueos/{docId} {
        allow get, list, write: if request.auth.uid == userId || isAdmin();
      }

      // REGLA NUEVA: Permite gestionar la disponibilidad granular.
      // Reemplaza el campo `horarios` del modelo antiguo.
      match /disponibilidad/{slotId} {
        allow read, list: if request.auth != null; // Cualquiera autenticado puede leer para buscar disponibilidad.
        allow create, update, delete: if request.auth.uid == userId || isAdmin(); // Solo el dueño o un admin puede modificar.
      }
    }

    match /reservas/{reservaId} {
      allow read: if (isAdmin() || (request.auth != null && (request.auth.uid == resource.data.uid || request.auth.uid == resource.data.profesionalId)));
      // Permite a un usuario autenticado listar reservas.
      // Las queries en el cliente DEBEN ser seguras y filtrar por UID del padre o del profesional.
      // ej. where('uid', '==', request.auth.uid) o where('profesionalId', '==', request.auth.uid)
      // La regla es permisiva, pero las queries del cliente son las que aseguran los datos.
      allow list: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.uid || request.auth.uid == resource.data.profesionalId || isAdmin());
      allow delete: if isAdmin();
      allow create: if request.auth != null;
    }

    match /nidos/{nidoId} {
      allow read, update: if request.auth != null &&
        (request.auth.uid in resource.data.padresUids || isAdmin());
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }

    match /bitacoras/{bitacoraId} {
      allow create: if request.auth != null && (
          (request.resource.data.keys().hasAny(['nidoId', 'prestadorId']) && isPrestador())
      );
      allow read, list: if request.auth != null && (
        esMiembroDelNido(resource.data.nidoId) || 
        (isPrestador() && resource.data.prestadorId == request.auth.uid) ||
        isAdmin()
      );
      allow update, delete: if request.auth != null &&
        (resource.data.prestadorId == request.auth.uid || isAdmin());
    }

    match /fichas_atencion/{fichaId} {
      allow create: if request.auth != null;
      allow read, list: if request.auth != null && (
        esMiembroDelNido(resource.data.nidoId) || 
        (isPrestador() && resource.data.consejeraId == request.auth.uid) ||
        isAdmin()
      );
      allow update, delete: if request.auth != null &&
        (resource.data.consejeraId == request.auth.uid || isAdmin());
    }

    match /productos/{productoId} {
      allow read, list: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock < resource.data.stock
      );
    }

    match /pedidos/{pedidoId} {
      allow create: if request.auth != null &&
        request.resource.data.compradorUid == request.auth.uid;
      allow read, list: if request.auth != null &&
        (resource.data.compradorUid == request.auth.uid || isAdmin());
      allow update: if request.auth != null && isAdmin();
      allow delete: if isAdmin();
    }

    match /tips/{tipId} {
      allow read, list: if true;
      allow create, update, delete: if request.auth != null &&
        (datosUsuario().puedeCrearTips == true || isAdmin());
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Los logs de auditoría son inmutables una vez creados
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
